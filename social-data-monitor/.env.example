# 将本文件复制为 .env.local，并在项目目录内填写本地私有配置和密钥。
# .env.local 必须留在 social-data-monitor/ 内，并保持 Git 忽略。

SOCIAL_MONITOR_DB_URL=
SOCIAL_MONITOR_DB_USERNAME=
SOCIAL_MONITOR_DB_PASSWORD=

SOCIAL_MONITOR_SECURITY_DEV_USERNAME=
